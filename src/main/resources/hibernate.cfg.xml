<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
<!--        <property name="hibernate.connection.url">jdbc:h2:tcp://localhost:9092/td7</property>-->
        <property name="hibernate.connection.url">jdbc:h2:mem:cruise</property>
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>
        <property name="show_sql">false</property>
        <property name="connection.pool_size">5</property>
        <property name="hibernate.id.new_generator_mappings">false</property>
        <property name="hibernate.hbm2ddl.auto">create</property>

        <!-- All entities to map -->
        <mapping class="td7.domain.cruise.Cruise" />
        <mapping class="td7.domain.cruise.cabin.CabinType" />
        <mapping class="td7.domain.cruise.cabin.CabinAvailabilities" />
        <mapping class="td7.domain.cruise.booking.CruiseBookings" />
        <mapping class="td7.domain.cruise.booking.Booking" />
        <mapping class="td7.domain.cruise.booking.traveler.Traveler" />
    </session-factory>
</hibernate-configuration>